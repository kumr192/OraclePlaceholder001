# Copy this file to .env and fill in your own values.
# Do not commit .env. Leave the password empty here.

ORACLE_FUSION_URL=https://your-instance.fa.ocs.oraclecloud.com
ORACLE_FUSION_USER=your_user
ORACLE_FUSION_PASSWORD=

# Optional. If you set this, the page and the API ask for it.
# Any username is fine. This is not your Oracle password.
APP_ACCESS_PASSWORD=
