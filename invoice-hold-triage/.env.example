# Copy this file to .env and fill in the secrets there.
# Do not commit .env. Leave the passwords empty here.
# The coordinator sets the same keys in Vercel. Do not put secrets in Git.

ORACLE_FUSION_URL=https://ibcrqy-test.fa.ocs.oraclecloud.com
ORACLE_FUSION_USER=
ORACLE_FUSION_PASSWORD=

# Required on Vercel. Optional on your computer.
# Any username is fine. This is not the Oracle password.
APP_ACCESS_PASSWORD=
